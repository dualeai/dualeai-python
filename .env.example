# Duale AI SDK configuration reference
# A source checkout can load a repository-root .env. Installed applications
# should export these variables or pass equivalent values to SDK configuration.

# Authentication and API

# Duale AI API token (required for live Platform workflows; MockSDK is offline)
# Starts with dualeai_ and contains at least 32 UTF-8 bytes (at most 256 characters).
# Obtain it through your Duale AI workspace access handoff.
DUALEAI_TOKEN=dualeai_your_provisioned_token_here

# HTTPS Gateway base URL for hpke-http/3 Task, Agent, and Library metadata calls.
# Leave unset to use https://api.duale.ai.
# DUALEAI_ENDPOINT=https://api.duale.ai

# Tenant path segment (required for Library operations and attachments)
# DUALEAI_TENANT_ID=tenant_example

# Provisioned Agent ID (required for hosted Tools and the attachment example)
# DUALEAI_AGENT_ID=agent_example

# Logging

# Enable verbose SDK logging. Default: false.
# DUALEAI_DEBUG=false

# Optional Activity-result cache

# Shared Redis backend for cached Activity results.
# Default connection attempt: redis://localhost:8010
# DUALEAI_REDIS_URL=redis://localhost:8010
# Use rediss:// for a TLS-enabled remote Redis endpoint.

# SQLite fallback for cached Activity results after a Redis connection failure.
# Default: cache.db under ~/.dualeai/cache/<API-token-hash>/
# Setting this path does not disable Redis; the SDK still tries its Redis URL first.
# DUALEAI_SQLITE_PATH=/protected/application-data/dualeai-cache.db

# Optional telemetry

# OpenTelemetry base endpoint for telemetry data; the SDK appends /v1/traces
# and /v1/metrics. The SDK does not configure OTLP log export; host-application
# logging and egress remain the application's responsibility.
# Default: http://localhost:4318 (OTLP/HTTP port).
# DUALEAI_OBSERVABILITY__ENDPOINT=https://telemetry.example.com

# Authentication token for the OTLP endpoint. Telemetry is disabled when unset.
# DUALEAI_OBSERVABILITY__TOKEN=your_otlp_token_here
