# DUALEAI_ENDPOINT=https://api.duale.ai

# Duale AI SDK Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Duale AI API token (required for every workflow)
# Starts with dualeai_ and contains 10-256 characters
# Obtain it through your Duale AI workspace access handoff.
DUALEAI_TOKEN=dualeai_your-token-here

# Tenant path segment (required for Library operations and attachments)
# DUALEAI_TENANT_ID=tenant_example

# Provisioned agent id (required when hosting tools or uploading task attachments)
# DUALEAI_AGENT_ID=agent_example

# ============================================================================
# OPERATIONAL SETTINGS
# ============================================================================

# Enable debug mode for verbose logging
# Default: false
# DUALEAI_DEBUG=false

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Redis URL for distributed caching (recommended for production)
# Default: redis://localhost:8010
# Use Redis for multi-replica stateless agent execution
# DUALEAI_REDIS_URL=redis://localhost:8010
# Use rediss:// for a TLS-enabled remote Redis endpoint

# SQLite database path for local caching (fallback)
# Default: a tenant-scoped cache.db under ~/.dualeai/cache/
# Used when Redis is unavailable or disabled
# DUALEAI_SQLITE_PATH=/protected/application-data/dualeai-cache.db

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# OpenTelemetry base endpoint for telemetry data (traces + metrics; the SDK
# appends /v1/traces and /v1/metrics — application logs never leave your
# environment)
# Default: http://localhost:4318 (OTLP/HTTP port)
# DUALEAI_OBSERVABILITY__ENDPOINT=https://telemetry.example.com

# Authentication token for OTLP endpoint
# Default: None (observability disabled)
# Required to enable telemetry collection
# DUALEAI_OBSERVABILITY__TOKEN=your-otlp-token-here
